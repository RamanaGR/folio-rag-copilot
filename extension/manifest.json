{
  "manifest_version": 3,
  "name": "Folio RAG Copilot",
  "version": "1.0.0",
  "description": "Privacy-first context-aware web form accessibility and writing copilot.",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Open Folio Copilot"},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}],
  "options_page": "sidepanel.html"
}
